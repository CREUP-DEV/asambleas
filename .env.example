# Aplicación
NUXT_SITE_URL=http://localhost:3000
TZ=Europe/Madrid
# Secreto maestro usado por sesiones de Better Auth.
# Generar con: openssl rand -base64 32
APP_SECRET=replace-with-a-long-random-secret

# Acceso administrador y OAuth
INITIAL_ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# API externa de sincronización de roles
NUXT_ROLE_API_URL=https://example.com/api/user/role

# Analítica Umami (dejar vacío en local)
NUXT_PUBLIC_UMAMI_HOST=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

# PostgreSQL
POSTGRES_USER=creup_asambleas
POSTGRES_PASSWORD=creup_dev_password
POSTGRES_DB=creup_asambleas
POSTGRES_PORT=5432

# Conexión a base de datos (scripts de migración y pool)
DATABASE_URL="postgresql://creup_asambleas:creup_dev_password@localhost:5432/creup_asambleas?schema=public"

# Máximo de conexiones del pool pg (por defecto: 20)
DATABASE_MAX_CONNECTIONS=20

# Herramientas locales
ADMINER_PORT=8080
