# Aplicación
NUXT_SITE_URL=http://localhost:3000
TZ=Europe/Madrid
# Secreto maestro usado por sesiones de Better Auth.
# Generar con: openssl rand -base64 32
APP_SECRET=replace-with-a-long-random-secret

# Acceso administrador y OAuth
INITIAL_ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# API de la Intranet (consulta de rol y listado de miembros). La consulta de rol
# usa ${NUXT_INTRANET_API_URL}/user/role; no definas NUXT_ROLE_API_URL, que la
# sustituiría.
NUXT_INTRANET_API_URL=https://intranet.creup.es/api/asambleas/v1
NUXT_INTRANET_API_TOKEN=

# Analítica Umami (dejar vacío en local)
NUXT_PUBLIC_UMAMI_HOST=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

# PostgreSQL
POSTGRES_USER=creup_asambleas
POSTGRES_PASSWORD=creup_dev_password
POSTGRES_DB=creup_asambleas
POSTGRES_PORT=5432

# Conexión a base de datos (scripts de migración y pool)
DATABASE_URL="postgresql://creup_asambleas:creup_dev_password@localhost:5432/creup_asambleas?schema=public"

# Máximo de conexiones del pool pg (por defecto: 20)
DATABASE_MAX_CONNECTIONS=20

# Exportaciones PDF generadas por pg-boss
EXPORT_STORAGE_DIR=.data/exports

# Herramientas locales
ADMINER_PORT=8080

# Despliegue (deploy.sh y rollback.sh; ver DEPLOYMENT.md)
# VPS_HOST=usuario@servidor
# COMPOSE_DIR=/home/usuario
# REMOTE_DIR=/home/usuario/asambleas
# GHCR_USERNAME=
# GHCR_TOKEN=
# NUXT_DEPLOY_SITE_URL=https://asambleas.creup.es
# NUXT_DEPLOY_UMAMI_HOST=
# NUXT_DEPLOY_UMAMI_WEBSITE_ID=
# DEPLOY_IMAGE_RETENTION=2
